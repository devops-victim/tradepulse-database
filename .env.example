PORT=4001
DATABASE_URL=postgresql://postgres:password@localhost:5432/bse_trades
NODE_ENV=development
DEFAULT_DELAY_MS=0
MAX_DELAY_MS=900000
DEFAULT_EXTRACTION_DELAY_MS=0
CORS_ORIGINS=http://localhost:3000
PG_POOL_MAX=10
# Configure the SAME independently generated random secret on BSE and TradePulse.
# Empty disables callback registration; must be at least 32 characters when set.
BSE_WEBHOOK_SECRET=
# Exact comma-separated URLs. No credentials, query strings, fragments or wildcards.
# Production requires an explicit allowlist and HTTPS.
BSE_CALLBACK_ALLOWLIST=http://localhost:4000/api/bse/notifications
BSE_WEBHOOK_TIMEOUT_MS=10000
BSE_WEBHOOK_MAX_ATTEMPTS=6
BSE_WEBHOOK_RETRY_BASE_MS=1000
BSE_WEBHOOK_RETRY_MAX_MS=300000
# Optional custom trusted CA for cloud TLS (PEM path):
# PG_SSL_CA_FILE=
# SEED_REFERENCE_TIME=2026-10-13T00:00:00Z
